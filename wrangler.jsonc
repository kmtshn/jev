{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jev-api-proxy",
  "main": "./worker/src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  }
}
